JWT_SECRET=replace-with-a-private-32-character-secret
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-your-admin-password
SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/database?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=database-username
SPRING_DATASOURCE_PASSWORD=database-password
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
DB_POOL_MAX=3
PORT=8081
